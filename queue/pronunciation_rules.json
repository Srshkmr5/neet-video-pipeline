{
  "_version": "1.0",
  "_description": "Multilingual Phonetic Dictionary & Pronunciation Rules for Edge-TTS in NEET Engine",
  "global": [
    { "find": "\\\\theta", "replace": "theta" },
    { "find": "\\\\alpha", "replace": "alpha" },
    { "find": "\\\\beta", "replace": "beta" },
    { "find": "\\\\gamma", "replace": "gamma" },
    { "find": "\\\\omega", "replace": "omega" },
    { "find": "\\\\lambda", "replace": "lambda" },
    { "find": "\\\\pi", "replace": "pie" },
    { "find": "\\\\mu", "replace": "mu" },
    { "find": "\\\\Delta", "replace": "delta" },
    { "find": "\\\\sigma", "replace": "sigma" },
    { "find": "\\\\frac\\{([^}]+)\\}\\{([^}]+)\\}", "replace": "\\1 divided by \\2" },
    { "find": "\\s*[\\*·]\\s*", "replace": " multiplied by ", "notes": "Prevent TTS from saying asterisk or middle dot" }
  ],
  "ta": [
    { "find": "\\bNEET\\b", "replace": "நீட்", "notes": "Pronounce as word 'Neet', not letter-by-letter N-E-E-T" },
    { "find": "\\bPYQ\\b", "replace": "பி ஒய் கியூ", "notes": "Previous year questions spoken acronym" },
    { "find": "\\bPYQs\\b", "replace": "பி ஒய் கியூ வினாக்கள்", "notes": "PYQ plural" },
    { "find": "\\bNCERT\\b", "replace": "என் சி இ ஆர் டி", "notes": "NCERT in Tamil" },
    { "find": "\\bHCV\\b", "replace": "ஹெச் சி வர்மா", "notes": "H.C. Verma reference" },
    { "find": "\\bsin\\s*\\(?theta\\)?", "replace": "சைன் தீட்டா", "notes": "Trigonometric sine theta" },
    { "find": "\\bcos\\s*\\(?theta\\)?", "replace": "காஸ் தீட்டா", "notes": "Trigonometric cosine theta" },
    { "find": "\\btan\\s*\\(?theta\\)?", "replace": "டான் தீட்டா", "notes": "Trigonometric tangent theta" },
    { "find": "\\bsin\\b", "replace": "சைன்", "notes": "Trigonometric sine" },
    { "find": "\\bcos\\b", "replace": "காஸ்", "notes": "Trigonometric cosine" },
    { "find": "\\btan\\b", "replace": "டான்", "notes": "Trigonometric tangent" },
    { "find": "\\btheta\\b", "replace": "தீட்டா", "notes": "Greek theta" },
    { "find": "m/s\\^?2", "replace": "மீட்டர் பர் வினாடி ஸ்கொயர்", "notes": "Acceleration unit" },
    { "find": "m/s\\b", "replace": "மீட்டர் பர் வினாடி", "notes": "Velocity unit" },
    { "find": "\\bkm/h\\b", "replace": "கிலோமீட்டர் பர் மணி", "notes": "Speed unit" },
    { "find": "v_0\\^?2?", "replace": "வி நாட் ஸ்கொயர்", "notes": "Initial velocity squared" },
    { "find": "v_0", "replace": "வி நாட்", "notes": "Initial velocity" },
    { "find": "H_\\{?max\\}?", "replace": "மேக்ஸிமம் உயரம்", "notes": "Maximum height" }
  ],
  "hi": [
    { "find": "\\bNEET\\b", "replace": "नीट", "notes": "Pronounce as word 'Neet', not letter-by-letter N-E-E-T" },
    { "find": "\\bPYQ\\b", "replace": "पी वाई क्यू", "notes": "Previous year question acronym" },
    { "find": "\\bPYQs\\b", "replace": "विगत वर्षों के प्रश्न", "notes": "PYQ plural" },
    { "find": "\\bNCERT\\b", "replace": "एनसीईआरटी", "notes": "Hindi NCERT" },
    { "find": "\\bHCV\\b", "replace": "एच सी वर्मा", "notes": "H.C. Verma" },
    { "find": "\\bsin\\s*\\(?theta\\)?", "replace": "साइन थीटा", "notes": "Trigonometric sine theta" },
    { "find": "\\bcos\\s*\\(?theta\\)?", "replace": "कॉस थीटा", "notes": "Trigonometric cosine theta" },
    { "find": "\\btan\\s*\\(?theta\\)?", "replace": "टैन थीटा", "notes": "Trigonometric tangent theta" },
    { "find": "\\bsin\\b", "replace": "साइन", "notes": "Trigonometric sine" },
    { "find": "\\bcos\\b", "replace": "कॉस", "notes": "Trigonometric cosine" },
    { "find": "\\btan\\b", "replace": "टैन", "notes": "Trigonometric tangent" },
    { "find": "\\btheta\\b", "replace": "थीटा", "notes": "Greek theta" },
    { "find": "m/s\\^?2", "replace": "मीटर प्रति सेकंड स्क्वायर", "notes": "Acceleration unit" },
    { "find": "m/s\\b", "replace": "मीटर प्रति सेकंड", "notes": "Velocity unit" },
    { "find": "\\bkm/h\\b", "replace": "किलोमीटर प्रति घंटा", "notes": "Speed unit" },
    { "find": "v_0", "replace": "वी नॉट", "notes": "Initial velocity" },
    { "find": "H_\\{?max\\}?", "replace": "अधिकतम ऊंचाई", "notes": "Maximum height" }
  ],
  "en": [
    { "find": "\\bNEET\\b", "replace": "Neet", "notes": "Capitalize as titlecase so TTS doesn't spell out N-E-E-T" },
    { "find": "\\bPYQ\\b", "replace": "P-Y-Q", "notes": "Hyphenated so it doesn't say 'pik'" },
    { "find": "\\bPYQs\\b", "replace": "P-Y-Qs", "notes": "Plural" },
    { "find": "\\bNCERT\\b", "replace": "N-C-E-R-T", "notes": "Spelled out acronym" },
    { "find": "\\bHCV\\b", "replace": "H C Verma", "notes": "H.C. Verma reference" },
    { "find": "\\bCh\\.?\\s*(\\d+)", "replace": "Chapter \\1", "notes": "Expand Ch 3 to Chapter 3 so TTS never says C H 3" },
    { "find": "\\bsin\\s*\\(?theta\\)?", "replace": "sine theta", "notes": "Math sine, not wrongdoing" },
    { "find": "\\bcos\\s*\\(?theta\\)?", "replace": "cosine theta", "notes": "Math cosine, not cause" },
    { "find": "\\btan\\s*\\(?theta\\)?", "replace": "tangent theta", "notes": "Math tangent, not skin tanning" },
    { "find": "\\bsin\\b", "replace": "sine", "notes": "Math sine function" },
    { "find": "\\bcos\\b", "replace": "cosine", "notes": "Math cosine function" },
    { "find": "\\btan\\b", "replace": "tangent", "notes": "Math tangent function" },
    { "find": "m/s\\^?2", "replace": "meters per second squared", "notes": "Acceleration unit" },
    { "find": "m/s\\b", "replace": "meters per second", "notes": "Velocity unit" },
    { "find": "\\bkm/h\\b", "replace": "kilometers per hour", "notes": "Speed unit" },
    { "find": "H_\\{?max\\}?", "replace": "H max", "notes": "Maximum height" },
    { "find": "v_0\\^?2?", "replace": "v naught squared", "notes": "Initial velocity squared" },
    { "find": "v_0", "replace": "v naught", "notes": "Initial velocity" }
  ]
}
