{
  "_version": "1.0",
  "_description": "Pre-packaged STEM Master Lexicon for Physics, Chemistry, Biology, and Mathematics in English, Hindi, and Tamil",
  "global": [
    { "find": "\\\\theta", "replace": "theta" },
    { "find": "\\\\alpha", "replace": "alpha" },
    { "find": "\\\\beta", "replace": "beta" },
    { "find": "\\\\gamma", "replace": "gamma" },
    { "find": "\\\\omega", "replace": "omega" },
    { "find": "\\\\lambda", "replace": "lambda" },
    { "find": "\\\\pi", "replace": "pie" },
    { "find": "\\\\mu", "replace": "mu" },
    { "find": "\\\\Delta", "replace": "delta" },
    { "find": "\\\\sigma", "replace": "sigma" },
    { "find": "\\\\sqrt\\{([^}]+)\\}", "replace": "square root of \\1" },
    { "find": "\\\\frac\\{([^}]+)\\}\\{([^}]+)\\}", "replace": "\\1 divided by \\2" }
  ],
  "ta": [
    { "find": "\\bNEET\\b", "replace": "நீட்", "notes": "NEET Exam" },
