    { "find": "\\bPYQs\\b", "replace": "P-Y-Qs", "notes": "Plural" },
    { "find": "\\bNCERT\\b", "replace": "N-C-E-R-T", "notes": "Spelled out cleanly" },
    { "find": "\\bHCV\\b", "replace": "H C Verma", "notes": "Author reference" },

